name: CI
on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - name: Install dependencies
        run: pip install -e ".[dev]"
      - name: Lint
        run: ruff check .
      - name: Test
        run: pytest -q
{% if config.ci.study_lint %}
      - name: Lint studies
        run: scaffold study lint
{% endif %}
{% if config.ci.plan_lint %}
      - name: Lint plans
        run: scaffold plan lint
{% endif %}
{% if config.inventory.enabled %}
      - name: System inventory
        run: scaffold inventory check
{% raw %}
      - name: Paused or deprecated components changed (INV-008)
        if: github.event_name == 'pull_request'
        run: |
          git fetch --no-tags --depth=1 origin "${{ github.base_ref }}"
          git diff --name-only "origin/${{ github.base_ref }}" HEAD \
            | scaffold inventory check --changed-files -
{% endraw %}
{% endif %}
{% if config.inventory.enabled %}
      - name: System inventory
        run: scaffold inventory check
{% raw %}
      - name: Paused or deprecated components changed (INV-008)
        if: github.event_name == 'pull_request'
        run: |
          git fetch --no-tags --depth=1 origin "${{ github.base_ref }}"
          git diff --name-only "origin/${{ github.base_ref }}" HEAD \
            | scaffold inventory check --changed-files -
{% endraw %}
{% endif %}
